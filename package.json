{
  "name": "bisotun-flow-extractor",
  "displayName": "Bisotun Flow Extractor",
  "description": "Deep method execution flow and context extractor for LLMs (Java, Python, TypeScript & JavaScript)",
  "version": "1.2.0",
  "publisher": "farzadafi",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bisotun Flow Extractor",
      "properties": {
        "bisotun.maxDepth": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "description": "Maximum depth of the call flow graph extracted from the caret method. 0 = root method only, 1 = direct callees, etc."
        },
        "bisotun.includeModels": {
          "type": "boolean",
          "default": true,
          "description": "Include related data models (DTOs / projections / records / classes) in the extracted flow."
        },
        "bisotun.useFallback": {
          "type": "boolean",
          "default": true,
          "description": "Allow the legacy line-based fallback crawler when symbol-based extraction cannot resolve a call."
        }
      }
    },
    "commands": [
      {
        "command": "bisotun.copyDeepFlow",
        "title": "Copy Deep Execution Flow",
        "category": "Bisotun"
      },
      {
        "command": "bisotun.copyShallowFlow",
        "title": "Copy Shallow Flow (1 Level)",
        "category": "Bisotun"
      },
      {
        "command": "bisotun.copyCodeOnly",
        "title": "Copy Code Only",
        "category": "Bisotun"
      },
      {
        "command": "bisotun.extractFlow",
        "title": "Extract Flow",
        "category": "Bisotun"
      }
    ],
    "submenus": [
      {
        "id": "bisotun.submenu",
        "label": "Bisotun"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "bisotun.submenu",
          "when": "editorTextFocus",
          "group": "navigation@1"
        }
      ],
      "bisotun.submenu": [
        {
          "command": "bisotun.copyDeepFlow",
          "group": "1_actions@1"
        },
        {
          "command": "bisotun.copyShallowFlow",
          "group": "1_actions@2"
        },
        {
          "command": "bisotun.copyCodeOnly",
          "group": "1_actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "bisotun.copyDeepFlow",
          "when": "editorTextFocus"
        },
        {
          "command": "bisotun.copyShallowFlow",
          "when": "editorTextFocus"
        },
        {
          "command": "bisotun.copyCodeOnly",
          "when": "editorTextFocus"
        },
        {
          "command": "bisotun.extractFlow",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.14"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/farzadafi/bisotun-vscode.git"
  },
  "license": "MIT",
  "keywords": [
    "java",
    "python",
    "typescript",
    "javascript",
    "code-extraction",
    "call-graph",
    "llm-context",
    "bisotun"
  ],
  "bugs": {
    "url": "https://github.com/farzadafi/bisotun-vscode.git"
  },
  "homepage": "https://github.com/farzadafi/bisotun-vscode.git",
  "icon": "pluginIcon.png"
}